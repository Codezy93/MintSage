# Public Supabase project URL and browser key
NEXT_PUBLIC_SUPABASE_URI=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional signup redirect URL
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
# Server key for private storage
SUPABASE_SECRET_KEY=
# Plaid credentials and Link configuration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_REDIRECT_URI=
# Server-side Gemini credential and forecast endpoint
GEMINI_API_KEY=
FORECAST_URL=http://127.0.0.1:8000/forecast
# Future agent workflow endpoint and shared server credential (also required by forecasting)
AGENT_SERVICE_URL=
AGENT_SERVICE_SECRET=
